<?xml version="1.0" encoding="utf-8"?>
<!-- The icon is a disc, and stays one on every launcher. The background is clear and the
     disc sits in the middle 72dp, so whatever shape a launcher masks icons to, the disc is
     what shows. The foreground is generated by tool/app_icon.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
